    <string name="install_failed_invalid_message">The downloaded file for %1$s is damaged or incomplete and has been deleted.\n\nDownload it again?</string>
    <string name="install_failed_blocked_message">The system blocked the installation of %1$s (for example Play Protect or a device policy), so uninstalling the current version would not help.\n\nAllow the installation when asked, or check Play Protect settings, and try again.</string>
